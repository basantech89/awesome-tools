{
	"name": "@awesome-tools/ui-blocks",
	"version": "0.4.1",
	"description": "Awesome UI Blocks library for everyone ⚡️",
	"keywords": [
		"awesome-tools",
		"awesome-ui",
		"awesome-ui-blocks",
		"ui-blocks",
		"ui-blocks-library"
	],
	"homepage": "https://github.com/basantech89/awesome-tools#readme",
	"bugs": {
		"url": "https://github.com/basantech89/awesome-tools/issues"
	},
	"license": "ISC",
	"author": "Basant Soni <basantech89@gmail.com> (https://basant.netlify.app/)",
	"repository": {
		"type": "git",
		"url": "https://github.com/basantech89/awesome-tools.git"
	},
	"files": [
		"dist",
		"!**/*.tsbuildinfo"
	],
	"type": "module",
	"main": "./dist/index.js",
	"module": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"imports": {
		"#blocks": "./src/index.ts",
		"#blocks/*": "./src/*"
	},
	"exports": {
		"./package.json": "./package.json",
		"./styles.css": "./dist/styles.css",
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js",
			"default": "./dist/index.js"
		}
	},
	"publishConfig": {
		"access": "public"
	},
	"devDependencies": {
		"@rolldown/plugins-monorepo": "rolldown/plugins",
		"next": "^16.1.6",
		"rolldown": "^1.1.0",
		"vite-plugin-ignore-dynamic-imports": "^1.0.2"
	},
	"peerDependencies": {
		"@awesome-tools/ui": "^0.5.1",
		"@awesome-tools/utils": "^0.4.1",
		"@dnd-kit/abstract": ">=0.3.2",
		"@dnd-kit/dom": ">=0.3.2",
		"@dnd-kit/helpers": ">=0.3.2",
		"@dnd-kit/react": ">=0.3.2",
		"@tanstack/react-table": ">=8.21.3",
		"date-fns": ">=4.1.0",
		"react": ">=19.0.0",
		"react-day-picker": ">=9.13.1",
		"react-dom": ">=19.0.0",
		"sonner": ">=2.0.7",
		"tailwind-merge": ">=3.4.0",
		"tailwind-variants": ">=3.2.2",
		"tailwindcss": ">=4",
		"zod": ">=4.3.5"
	},
	"nx": {
		"name": "ui-blocks",
		"tags": [
			"awesome-tools",
			"ui-blocks",
			"awesome-ui",
			"react",
			"ui-library"
		],
		"targets": {
			"lint": {}
		}
	}
}
