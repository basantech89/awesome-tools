{
	"name": "@awesome-tools/ui",
	"version": "0.2.0",
	"description": "Awesome UI library for everyone 🎨",
	"author": "Basant Soni <basantech89@gmail.com> (https://basant.netlify.app/)",
	"repository": {
		"type": "git",
		"url": "https://github.com/basantech89/awesome-tools.git"
	},
	"keywords": [
		"ui",
		"awesome-ui",
		"ui-library",
		"awesome-tools"
	],
	"bugs": {
		"url": "https://github.com/basantech89/awesome-tools/issues"
	},
	"license": "ISC",
	"homepage": "https://github.com/basantech89/awesome-tools#readme",
	"type": "module",
	"main": "./dist/index.js",
	"module": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"imports": {
		"#ui": "./src/index.ts",
		"#ui/*": "./src/*"
	},
	"exports": {
		"./package.json": "./package.json",
		"./styles.css": "./dist/styles.css",
		".": {
			"import": "./dist/index.js",
			"types": "./dist/index.d.ts",
			"default": "./dist/index.js"
		}
	},
	"sideEffects": [
		"**/*.css"
	],
	"files": [
		"dist/*",
		"!**/*.tsbuildinfo"
	],
	"nx": {
		"name": "ui",
		"tags": [
			"ui",
			"type:ui",
			"scope:shared"
		]
	},
	"peerDependencies": {
		"react": "^19.2.0",
		"react-dom": "^19.2.0",
		"tailwind-merge": "^3.4.0",
		"tailwindcss": "^4"
	},
	"peerDependenciesMeta": {
		"tailwind-merge": {
			"optional": true
		}
	},
	"dependencies": {
		"@awesome-tools/utils": "workspace:*",
		"@base-ui/react": "^1.0.0",
		"tailwind-variants": "^3.2.2"
	},
	"devDependencies": {
		"shadcn": "^3.6.2",
		"tw-animate-css": "^1.4.0"
	},
	"publishConfig": {
		"access": "public"
	}
}
