{
  "name": "@awesome-tools/ui",
  "version": "0.5.0",
  "description": "Awesome UI library for everyone 🎨",
  "keywords": [
    "awesome-tools",
    "awesome-ui",
    "ui",
    "ui-library"
  ],
  "homepage": "https://github.com/basantech89/awesome-tools#readme",
  "bugs": {
    "url": "https://github.com/basantech89/awesome-tools/issues"
  },
  "license": "ISC",
  "author": "Basant Soni <basantech89@gmail.com> (https://basant.netlify.app/)",
  "repository": {
    "type": "git",
    "url": "https://github.com/basantech89/awesome-tools.git"
  },
  "files": [
    "dist/*",
    "!**/*.tsbuildinfo"
  ],
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "imports": {
    "#ui": "./src/index.ts",
    "#ui/*": "./src/*"
  },
  "exports": {
    "./package.json": "./package.json",
    "./styles.css": {
      "@awesome-tools/source": "./src/styles.css",
      "default": "./dist/styles.css"
    },
    ".": {
      "@awesome-tools/source": "./src/index.ts",
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@base-ui/react": "^1.0.0",
    "cmdk-base": "^1.0.0"
  },
  "devDependencies": {
    "shadcn": "^3.6.2",
    "tw-animate-css": "^1.4.0"
  },
  "peerDependencies": {
    "@awesome-tools/utils": "workspace:*",
    "react": ">=19.0.0",
    "react-dom": ">=19.0.0",
    "tailwind-merge": ">=3.4.0",
    "tailwind-variants": ">=3.2.2",
    "tailwindcss": ">=4"
  },
  "nx": {
    "name": "ui",
    "tags": [
      "ui",
      "type:ui",
      "scope:shared"
    ],
    "targets": {
      "lint": {}
    }
  }
}
