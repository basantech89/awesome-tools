name: ci

on:
  pull_request:

permissions:
  actions: read
  contents: read

jobs:
  main:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v6
        with:
          filter: tree:0
          fetch-depth: 2
      <% if (pm === 'bun') { %>
      - uses: oven-sh/setup-bun@v2
        with:
          bun-version: latest
      <% } else if (pm === 'pnpm') { %>
      - uses: actions/setup-node@v6
        with:
          cache: 'pnpm'
          cache-dependency-path: '**/pnpm-lock.yaml'
          node-version: 24
      <% } else if (pm === 'yarn') { %>
      - uses: actions/setup-node@v6
        with:
          cache: 'yarn'
          cache-dependency-path: '**/yarn.lock'
          node-version: 24
      <% } else if (pm === 'npm') { %>
      - uses: actions/setup-node@v6
        with:
          cache: 'npm'
          cache-dependency-path: '**/package-lock.json'
          node-version: 24
      <% } %>
      
      # This enables task distribution via Nx Cloud
      # Run this command as early as possible, before dependencies are installed
      # Learn more at https://nx.dev/ci/reference/nx-cloud-cli#npx-nxcloud-startcirun
      # Uncomment this line to enable task distribution
      - run: <%= dlx %> nx start-ci-run --distribute-on="3 linux-medium-js" --stop-agents-after="build"
      
      - run: <%= pm %> install --no-cache
      - uses: nrwl/nx-set-shas@v4

      # Prepend any command with "nx-cloud record --" to record its logs to Nx Cloud
      # - run: npx nx-cloud record -- npx nx format:check  --base="remotes/origin/main"

      # - run: bun nx-cloud record -- echo Hello World
      - name: validate
        run: <%= pm %> validate:affected

      # Nx Cloud recommends fixes for failures to help you get CI green faster. Learn more: https://nx.dev/ci/features/self-healing-ci
      - run: <%= pm %> nx fix-ci
        if: always()
