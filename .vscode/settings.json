{
	"js/ts.tsdk.path": "node_modules/typescript/lib",
	"tailwindCSS.classFunctions": ["cn", "cva", "tv"],
	"tailwindCSS.experimental.configFile": {
		"packages/ui/src/styles.css": "packages/ui/src/**",
		"packages/ui-blocks/src/styles.css": "packages/ui-blocks/src/**"
	},
	"json.schemas": [
		{
			"fileMatch": [
				"nodemon.json",
				"nodemon.*.json",
				".nodemonrc",
				".nodemonrc.json"
			],
			"url": "https://json.schemastore.org/nodemon.json"
		}
	],
	"cSpell.words": ["datamodel", "DMMF"]
}
