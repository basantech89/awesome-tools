{
  "typescript.tsdk": "node_modules/typescript/lib",
  "tailwindCSS.experimental.configFile": {
    "packages/ui/src/index.css": "packages/ui/src/**",
    "packages/ui-blocks/src/index.css": "packages/ui-blocks/src/**"
  },
  "biome.lsp.bin": "/opt/homebrew/bin/biome",
  "json.schemas": [
    {
      "fileMatch": [
        "**/*.biome.json"
      ],
      "url": "https://biomejs.dev/schemas/2.3.14/schema.json"
    }
  ],
  "biome.configurationPath": "./biome.json"
}